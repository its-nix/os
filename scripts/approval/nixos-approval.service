[Unit]
Description=Deliver Nix founder approval requests and refresh company health

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecCondition=/usr/bin/test -f /srv/nix-clean/todoist/token
ExecCondition=/usr/bin/test -f /srv/nix-clean/todoist/project-id
ExecStart=/usr/bin/flock -n -E 0 /run/lock/nix-os-deploy.lock /usr/bin/python3 -IB /opt/nix-clean-source/scripts/approval/worker.py
# Refresh even when the approval worker fails or its credentials have not been provisioned.
ExecStopPost=-/usr/bin/flock -n -E 0 /run/lock/nix-os-deploy.lock /usr/bin/python3 -IB /opt/nix-clean-source/scripts/deploy-os.py --refresh-health
TimeoutStartSec=75s
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/run/lock /srv/nix-clean/approvals/outbox /srv/nix-clean/approvals/status /srv/nix-clean/approvals/state /srv/nix-clean/hermes/nix
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
