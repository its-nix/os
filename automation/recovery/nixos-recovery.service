[Unit]
Description=Verified private Docker Hub backup of Nix OS
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
# Every attempt cold-stops the OS services. Bound retries: one run plus two 15-minute retries
# fit inside 2h; then stop until the next daily timer run (well outside the window, so the
# next day's start is never rate-limited, unlike a 24h window).
StartLimitIntervalSec=2h
StartLimitBurst=3

[Service]
Type=oneshot
User=root
UMask=0077
EnvironmentFile=/etc/nixos/recovery.env
ExecStart=/usr/bin/python3 /opt/nix-clean-source/automation/recovery/full_create.py --apply --publish --image ${NIXOS_RECOVERY_IMAGE}
# Also recover services if Python is killed or the job times out before its finally block. A
# container deleted while stopped (core, or CRM when enabled) is recreated from the deployed compose
# file with the CRM profile when enabled (state is bind-mounted).
ExecStopPost=/usr/bin/flock -w 240 /run/lock/nix-os-deploy.lock /bin/sh -c 'rc=0; crm=; if [ -e /srv/nix-clean/twenty/ENABLED ]; then crm="--profile crm"; for c in nixos-twenty-redis nixos-twenty-db nixos-twenty-server nixos-twenty-worker; do docker start $$c || rc=1; done; fi; for c in nixos-hermes nixos-t3 nixos-reviewer; do docker start $$c || rc=1; done; if [ $$rc -ne 0 ]; then docker compose -p nixos --env-file /srv/nix-clean/deployment.env -f /opt/nix-clean-source/deploy/compose.yaml $$crm up --detach --no-recreate && rc=0; fi; exit $$rc'
Restart=on-failure
RestartSec=15min
TimeoutStartSec=1h
TimeoutStopSec=5min

