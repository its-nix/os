#!/bin/sh
set -eu
case "${1-}" in login|sync|resync) ;; *) exit 2;; esac
[ "$#" = 1 ]
# A private nosymfollow bind prevents path traversal through concurrently replaced
# vault components while the credentialed host process accesses agent-written files.
exec flock --no-fork -w 300 /run/lock/nix-os-deploy.lock unshare --mount --propagation private \
    /bin/sh -ec 'p=/srv/nix-clean/vault/Workspace
                 mount --bind "$p" "$p"
                 mount -o remount,bind,nosymfollow,nodev,nosuid,noexec "$p"
                 exec /usr/bin/python3 -I /opt/nix-clean-source/deploy/drive/vault.py "$1"' sh "$1"
